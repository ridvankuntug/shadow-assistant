# wake-svc settings (docs/05-deploy.md section 5, services/wake-svc/README.md).
# Copy to /etc/shadow-assistant/wake-svc.env (root:root, mode 0600) and replace
# every <placeholder>. Never commit the filled-in file.
#
# The token is NOT set here: it comes from /etc/credstore/wake-svc.token through
# LoadCredential= in the unit. Do not add WAKE_TOKEN (refused at startup) or
# WAKE_TOKEN_FILE (would bypass the credential).

# The PC's WIRED adapter MAC, aa:bb:cc:dd:ee:ff or AA-BB-CC-DD-EE-FF.
WAKE_MAC=<pc-wired-mac>

# The box's own LAN IPv4 address. Not 0.0.0.0, not a host name, not IPv6.
WAKE_BIND=<box-lan-ip>

# Comma list of IPv4 broadcast addresses (at most 8): the LAN's
# subnet-directed broadcast; 255.255.255.255 may be added.
WAKE_BROADCASTS=<lan-broadcast>

# TCP port (default 8704). Keep it above 1023: the unit grants no capabilities.
#WAKE_PORT=8704

# Address the UDP socket is bound to (default: WAKE_BIND). Set it only if the
# packet must leave from a different local address than the listener.
#WAKE_SOURCE_ADDR=<box-lan-ip>
