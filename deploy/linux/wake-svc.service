# wake-svc: Wake-on-LAN endpoint for Shadow Assistant (services/wake-svc,
# docs/12-wake-and-headless-core.md D1/D6). Install steps: docs/05-deploy.md,
# section 5 "Wake endpoint on the always-on Linux box".
#
# NEVER expose this service through the Cloudflare tunnel or any other public
# route. It listens on the box's LAN address only (WAKE_BIND); away from home
# the phone reaches it through the Tailscale subnet route, like the Core.
#
# Files this unit expects (created by hand, see docs/05):
#   /opt/shadow-assistant/wake-svc/server.py   code (root:root 0644, dir 0755)
#   /etc/shadow-assistant/wake-svc.env         settings, no secret (root:root 0600)
#   /etc/credstore/wake-svc.token              wake token (root:root 0600, dir 0700)
# The token is handed to the service with LoadCredential=; it never appears in
# the environment, on a command line or in this file. This file holds no
# addresses, MACs or tokens: keep it that way.

[Unit]
Description=Shadow Assistant wake-svc (Wake-on-LAN endpoint, LAN only)
# WAKE_BIND is the LAN address; binding fails until the interface has it.
Wants=network-online.target
After=network-online.target
# Never give up restarting: after a power cut the box can boot long before the
# router hands out its address, and binding WAKE_BIND fails until then. A bad
# configuration (exit code 1) then repeats one journal line every 15 s
# (systemctl status / journalctl -u wake-svc shows the reason).
StartLimitIntervalSec=0

[Service]
Type=simple
# -I: isolated mode, ignores PYTHON* variables, the user site directory and the
# script's directory on sys.path. The script imports the standard library only.
ExecStart=/usr/bin/python3 -I /opt/shadow-assistant/wake-svc/server.py
EnvironmentFile=/etc/shadow-assistant/wake-svc.env
# Token file -> $CREDENTIALS_DIRECTORY/wake-token, readable only by this
# service's dynamic user. Do not set WAKE_TOKEN_FILE in the env file.
LoadCredential=wake-token:/etc/credstore/wake-svc.token
Restart=on-failure
RestartSec=15s

# --- identity and privileges
DynamicUser=yes
NoNewPrivileges=yes
# Sending a UDP broadcast (SO_BROADCAST) and listening on a port > 1023 need
# no capability. Keep WAKE_PORT above 1023.
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# --- file system: nothing writable, no home, no devices
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes

# --- kernel interfaces
# AF_INET: HTTP listener and the magic packet. AF_UNIX: journald/syslog.
# AF_INET6 is kept as in docs/12 (D1); wake-svc itself refuses IPv6 addresses.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

# --- resources (8 request threads at most, ~20 MB resident)
MemoryMax=64M
TasksMax=32

# Optional, kernel-level allow list for incoming and outgoing IP traffic, on
# top of a firewall. Needs the real ranges, so set it in a drop-in
# (systemctl edit wake-svc), never in this tracked file:
#   [Service]
#   IPAddressDeny=any
#   IPAddressAllow=<lan-cidr> <tailnet-cidr>
# The broadcast addresses are inside <lan-cidr>; 255.255.255.255, if used,
# must be listed too.

[Install]
WantedBy=multi-user.target
