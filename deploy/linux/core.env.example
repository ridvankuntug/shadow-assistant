# Shadow Assistant Core settings on the Pi (docs/13-pi-core-and-agents.md
# section 7.1; docs/05-deploy.md section 7). Copy to
# /etc/shadow-assistant/core.env (root:root, mode 0644: no secret in it, the
# backup unit reads it too) and replace every <placeholder>. Never commit the
# filled-in file. Every setting of the repo-root .env.example works here; the
# ones below are those the Pi needs or that differ from the defaults.
#
# Secrets are NOT set here: HA_CORE_TOKEN, DEVICE_TOKEN_<NAME> and (later)
# CORE_AGENT_TOKEN come from /etc/credstore/shadow-core.<VARIABLE> through
# LoadCredential= in the unit. A secret set here as well stops the Core at start.

# --- Listener (docs/13 section 4.2)
# The Pi's own LAN IPv4 address; not 0.0.0.0 (nothing listens on all
# interfaces, so the tailnet reaches the Core only through Tailscale serve).
CORE_HOST=<pi-lan-ip>
# Keep it above 1023: the unit grants no capabilities. Default 8700.
CORE_PORT=<core-port>
# The second plain listener (Tailscale serve, the updater's health check).
CORE_EXTRA_HOSTS=127.0.0.1

# --- TLS listener for the PC's browser (docs/13 section 4; docs/05 section 7
# "HTTPS listener"): the UI, /ws and /health at https://<pi-lan-ip>:<tls-port>/.
# Keep these commented until "sudo shadow-core-tls init --ip <pi-lan-ip>" has
# created the CA and the certificate (docs/05 section 7 "HTTPS certificate").
# Then uncomment the three lines (CORE_TLS_HOST: the same address; renewals
# read it from here) and run install-core.sh install --user <user> again: it
# adds LoadCredential=tls-key:/etc/credstore/shadow-core.tls-key to local.conf
# only while CORE_TLS_HOST is set. A partial setting stops the Core.
#CORE_TLS_HOST=<pi-lan-ip>
#CORE_TLS_PORT=<tls-port>
#CORE_TLS_CERT_FILE=/etc/shadow-assistant/tls/core.crt
# Optional LAN host name (placeholder; one lower-case DNS name, no wildcard):
# also allowed as https://<name>:<tls-port>/. It is part of the CA: give init
# the same name (--hostname <name>), and recreate the CA (init --recreate-ca)
# when it is added, changed or removed. The name must resolve to the Pi on the LAN (router DNS or the PC
# hosts file; set up outside this project).
#CORE_TLS_HOSTNAME=shadow.lan
# Default: <release>/ui/dist (the Core release package, T12.1).
#CORE_UI_DIR=

# --- Folders (docs/13 section 7.1): the StateDirectory of the unit
SHADOW_DATA_DIR=/var/lib/shadow-assistant/data
SHADOW_VAULT_DIR=/var/lib/shadow-assistant/vault

# --- Rehearsal (T11.5): on at install, so the Pi Core runs next to the PC Core
# without raising notifications twice. Turned off at the move (T23.2).
CORE_REHEARSAL=1

# --- Home Assistant
# Reached directly over the LAN (no agent in between). Base URL of the HA
# instance, e.g. http://<ha-lan-ip>:8123. The token is a credential (see above).
HA_URL=<ha-lan-url>

# --- Speech services (T11.4, docs/13 section 5.2): whisper and TTS run on the
# PC and are reached through the PC agent's restricted forwarder; services.yaml
# itself does not change. Keep these commented until the agent forwarder (T15)
# is in the Core: today services.yaml accepts http(s) URLs only, so agent://
# stops the Core at start. Uncomment once T15 is in.
#WHISPER_SVC_URL=agent://whisper-svc
#TTS_SVC_URL=agent://tts-svc

# The PC agent's source address for /agent (CORE_AGENT_SOURCE) is added with
# the agent channel (T13).

# --- Devices (docs/08, docs/11): names as in DEVICE_TOKEN_<NAME>, any case.
CORE_DEV_DEVICES=<device-names>
CORE_PC_PERMISSION_DEVICES=<device-names>

# --- Optional, defaults shown in the repo-root .env.example
#CORE_QUIET_HOURS=00:00-09:00
#CORE_MODEL_TIER1=
#CORE_MODEL_TIER2=
#CORE_MODEL_TIER3=
#CORE_MEMORY=
#CORE_AGENT_IDLE_MIN=
