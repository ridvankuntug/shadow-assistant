<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- WebSocket to the Core (the UI) and the native reachability probe. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17+ (API 37) runtime permission for LAN addresses (the Core at 192.168.1.2, on
         Wi-Fi or through the Tailscale subnet route). Asked at startup; unknown and ignored below
         API 37, so no maxSdk/minSdk scoping is needed. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Push-to-talk; requested at the first startCapture, never used in the background. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Confirmation requests while the app is in the background (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Galaxy Buds case battery shared by Buds Case Widget (T11): its read-only provider and change
         broadcast. "dangerous", defined by that app: asked once at startup only if it is installed. -->
    <uses-permission android:name="io.github.budscasewidget.permission.READ_CASE_BATTERY" />
    <!-- In-app update (docs/10): hand a verified release APK to PackageInstaller. Special access
         ("install unknown apps") granted by the user once; the system always asks to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Package visibility (Android 11+): TextToSpeech must be able to find the TTS engine. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- Buds Case Widget: its permission and provider must be visible to check their owner. -->
        <package android:name="io.github.budscasewidget" />
    </queries>

    <!-- The token blob is useless elsewhere (its Keystore key never leaves the device): no backups. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shadow">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Assist gesture when Shadow is the selected assist app. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Launcher shortcut "Güncellemeleri denetle" → UpdateActivity (docs/10 D5). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- In-app update (docs/10). Not exported: started by the static shortcut and by the
             install-status PendingIntent only. Own task affinity, because the launcher starts
             shortcuts with CLEAR_TASK, which must not clear MainActivity's task. -->
        <activity
            android:name=".UpdateActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="app.shadowassistant.android.update"
            android:theme="@style/Theme.Shadow.Update" />

        <!-- Default digital assistant role (T6.3). -->
        <service
            android:name=".assist.ShadowVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".assist.ShadowSessionService"
            android:exported="false"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Required by the voice interaction service declaration. It refuses every request,
             so exposing it without a permission gives callers nothing but an error. -->
        <service
            android:name=".assist.ShadowRecognitionService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Buds Case Widget change broadcast (T11). Sent explicitly to this package with
             sendBroadcast(intent, READ_CASE_BATTERY), so only a holder of the permission gets it.
             No android:permission here: the sender does not hold READ_CASE_BATTERY itself, so that
             would block the real broadcast. Exported because the sender is another app; any app
             could send it, so the receiver ignores the extras and only enqueues a job that reads
             the permission-protected provider (see CaseBatterySync). -->
        <receiver
            android:name=".CaseBatteryReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.budscasewidget.action.CASE_BATTERY_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
