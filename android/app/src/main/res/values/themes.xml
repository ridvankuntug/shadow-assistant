<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="shadow_background">#FF05070D</color>
    <color name="shadow_accent">#FF4FC3F7</color>

    <!--
      The web UI's palette (ui/src/index.css, the :root variables), for native screens drawn next to it
      (the error panel). The UI is dark only (color-scheme: dark), so these have no light variant.
    -->
    <color name="ui_bg">#FF01060C</color>               <!-- bg -->
    <color name="ui_panel">#D104121C</color>            <!-- panel: rgba(4, 18, 28, 0.82) -->
    <color name="ui_line">#2E00E5FF</color>             <!-- line: rgba(0, 229, 255, 0.18) -->
    <color name="ui_text">#FFD9F6F8</color>             <!-- text -->
    <color name="ui_muted">#FF7FA3A8</color>            <!-- muted -->
    <color name="ui_accent">#FF00E5FF</color>           <!-- interface -->
    <color name="ui_primary">#FF00C3D9</color>          <!-- .btn-primary: accent 85% mixed with black -->
    <color name="ui_on_primary">#FF01141A</color>       <!-- .btn-primary text -->
    <color name="ui_ghost">#0AFFFFFF</color>            <!-- .btn-ghost: rgba(255, 255, 255, 0.04) -->
    <color name="ui_ripple">#3300E5FF</color>
    <color name="ui_ripple_on_primary">#3301141A</color>

    <style name="Theme.Shadow" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/shadow_background</item>
        <item name="android:colorAccent">@color/shadow_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The error panel's card (.connect-card): full width on phones; values-w600dp caps it at 420dp. -->
    <style name="Widget.Shadow.ErrorCard.Base" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/bg_error_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingVertical">24dp</item>
    </style>

    <style name="Widget.Shadow.ErrorCard" parent="Widget.Shadow.ErrorCard.Base" />

    <!-- The web UI's .btn (ui/src/index.css): 12dp corners, 1dp line border, 15sp, no caps. -->
    <style name="Widget.Shadow.Button" parent="android:Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- .btn-primary -->
    <style name="Widget.Shadow.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/ui_on_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- .btn .btn-ghost -->
    <style name="Widget.Shadow.Button.Ghost">
        <item name="android:background">@drawable/bg_button_ghost</item>
        <item name="android:textColor">@color/ui_text</item>
    </style>

    <!-- UpdateActivity (docs/10): a small dialog over whatever is on screen. -->
    <style name="Theme.Shadow.Update" parent="android:Theme.Material.Dialog">
        <item name="android:colorAccent">@color/shadow_accent</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>
