<?xml version="1.0" encoding="utf-8"?>
<!-- The web UI's .btn.btn-ghost: faint fill, 1dp line border, 12dp corners. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ui_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_ghost" />
            <stroke android:width="1dp" android:color="@color/ui_line" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
