<?xml version="1.0" encoding="utf-8"?>
<!--
  Template of res/xml/network_security_config.xml: the build (tasks
  generateNetworkSecurityConfigDebug / Release, app/build.gradle.kts) copies it
  into a generated resource folder per build type and replaces the
  CLEARTEXT_HOSTS marker below with a cleartext domain-config for a debug
  build's development hosts, or drops the marker when there are none (the
  default, and always for release).

  The Core is reached only through `wss://` and the wake endpoint only through
  `https://` (T21.3.3), so a released APK allows no cleartext at all. The
  optional development hosts come from the Gradle properties `shadowCoreHost` /
  `shadowWakeHost` or the environment variables SHADOW_CORE_HOST /
  SHADOW_WAKE_HOST and are never committed.
  Everything else must use TLS with a system CA (no user-installed CAs).
  The generated file is unit-tested against CoreAddress.CLEARTEXT_HOST and
  WakeAddress.CLEARTEXT_HOST.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- CLEARTEXT_HOSTS -->
</network-security-config>
