# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored. Never commit real tokens, hostnames or IP addresses.
# Variables already set in the real environment take precedence over `.env`.

# --- Core ---
# Interface the Core WebSocket API binds to. Default 127.0.0.1 (this machine
# only); use 0.0.0.0 to accept connections from the phone on the LAN.
CORE_HOST=127.0.0.1
# Port the Core WebSocket API listens on (ws://<host>:<port>/ws).
CORE_PORT=8700
# Optional: how often the Core polls each service's /health and the per-check
# timeout, in milliseconds (defaults 30000 / 3000).
CORE_HEALTH_INTERVAL_MS=
CORE_HEALTH_TIMEOUT_MS=
# Model routing (see router.yaml and docs/04-router.md). Each value is a Claude
# model alias or id.
# Tier 1, cheap first try (short answers, one tool). Default: haiku.
CORE_MODEL_TIER1=
# Tier 2, default model. Default: CORE_MODEL, else sonnet.
CORE_MODEL_TIER2=
# Tier 3, only for explicit planning / deep-analysis requests. Default: opus.
CORE_MODEL_TIER3=
# Pre-T7 setting, still honoured: the tier-2 model when CORE_MODEL_TIER2 is empty
# (with CORE_ROUTER=off, the only model).
CORE_MODEL=
# off = no routing: every turn on the tier-2 model, no direct (model-free) Home
# Assistant calls, no escalation. Default: on.
CORE_ROUTER=
# Alternative router file. Default: router.yaml in the repo root.
SHADOW_ROUTER_FILE=
# Optional: TTS pronunciation lexicon (default: repo-root pronunciations.yaml)
# SHADOW_PRONUNCIATIONS_FILE=
# Optional fallback. By default the Agent SDK uses the local Claude Code login;
# set an Anthropic API key only if that login should not be used.
ANTHROPIC_API_KEY=
# Safety switch for smoke tests: 1 = only `read` tools may run, everything else
# is denied without asking.
CORE_READ_ONLY=
# How long a confirmation waits before it counts as "no" (ms). Default: 60000.
CORE_CONFIRM_TIMEOUT_MS=

# --- Tray app (deploy/windows/tray, see docs/05-deploy.md) ---
# Port the tray app serves the web UI (ui/dist) on: http://localhost:<port>/.
# Default: 8703.
SHADOW_UI_PORT=
# Environment only, NOT read from this file (it is found through them): repo
# root, node.exe and log folder of the tray app and run-core.ps1. The
# scheduled task passes them as arguments instead. Defaults: the first folder
# above the tray exe that has core\ and services.yaml, node.exe from PATH,
# %LOCALAPPDATA%\ShadowAssistant\logs.
# SHADOW_REPO_ROOT=
# SHADOW_NODE_PATH=
# SHADOW_CORE_LOG_DIR=

# --- Home Assistant (via MCP, see services.yaml) ---
# Base URL of your Home Assistant instance, e.g. http://homeassistant.local:8123
HA_URL=
# Long-lived access token created for the Core in Home Assistant.
HA_CORE_TOKEN=

# --- Speech services ---
# Base URL of whisper-svc (speech-to-text). Default: http://127.0.0.1:8701
WHISPER_SVC_URL=
# Base URL of tts-svc (Piper text-to-speech). Default: http://127.0.0.1:8702
TTS_SVC_URL=

# --- Shadow vault ---
# Absolute path of your notes vault. The read-only vault tool is disabled when
# this is empty. Readable folders are set in services.yaml (`allow`).
SHADOW_VAULT_DIR=
# Where conversation logs and usage records (usage/YYYY-MM-DD.jsonl) are
# written. Default: <SHADOW_VAULT_DIR>/.shadow-assistant (the Core puts a
# `.gitignore` containing `*` into it and into its usage/ folder).
SHADOW_DATA_DIR=

# --- Device tokens ---
# One token per client device (browser, Android shell); more can be added as
# DEVICE_TOKEN_<NAME>. Empty values are ignored; at least one is required and
# each must be at least 16 characters. Generate random values, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
DEVICE_TOKEN_BROWSER=
DEVICE_TOKEN_ANDROID=

# --- Docker Compose (deploy/docker-compose.yml, see docs/05-deploy.md) ---
# Restart policy of the speech containers: "no" (default, start by hand) or
# "unless-stopped" (come back with Docker Desktop after a reboot). "always"
# restarts whisper-svc after a Docker restart even in tray game mode; the tray
# stops it again at its next start.
SHADOW_RESTART=
# Host address the service ports are published on. Default 127.0.0.1.
SHADOW_SERVICES_BIND=
# whisper-svc model settings. Defaults: large-v3, float16, 1, 1.
WHISPER_MODEL=
WHISPER_COMPUTE_TYPE=
WHISPER_BEAM_SIZE=
WHISPER_VAD=
# whisper-svc: unload the speech model from the GPU after this many minutes
# without requests (frees ~3.9 GB VRAM with large-v3 float16); the next voice
# command reloads it and is a few seconds slower. 0 = never unload.
WHISPER_IDLE_UNLOAD_MIN=10
# 1 = never contact Hugging Face (model must already be in the volume). Default 0.
HF_HUB_OFFLINE=
# tts-svc voice settings. Defaults: tr_TR-dfki-medium, (none), 1.
TTS_VOICE=
TTS_VOICES=
TTS_AUTO_DOWNLOAD=
# TTS_VOICE_LOAD_WAIT_S=20  # tts-svc: seconds /synthesize waits for an on-demand voice download/load before 503 voice_loading; keep below the Core's tts-svc timeout (30 s)

# --- Backups (deploy/backup/, see docs/05-deploy.md) ---
# The data folder backed up is SHADOW_DATA_DIR (above).
# Crypt secrets for the encrypted Drive backup. Generate random values once and
# keep them in your password manager: without them the backups can never be
# decrypted. Used only by the backup scripts, never written to rclone.conf.
SHADOW_BACKUP_CRYPT_PASSWORD=
SHADOW_BACKUP_CRYPT_SALT=
# rclone Google Drive remote (scope drive.file) and folder on it. Defaults:
# gdrive, shadow-assistant-backup.
SHADOW_BACKUP_DRIVE_REMOTE=
SHADOW_BACKUP_DRIVE_PATH=
# Name of the crypt remote (letters, digits, _). Default: shadowcrypt.
SHADOW_BACKUP_CRYPT_REMOTE=
# Days archives are kept on Drive (0 = keep all). Default: 60.
SHADOW_BACKUP_REMOTE_DAYS=
# Local archive folder and how many archives to keep there. Defaults:
# %LOCALAPPDATA%\ShadowAssistant\backups, 3.
SHADOW_BACKUP_LOCAL_DIR=
SHADOW_BACKUP_LOCAL_KEEP=
# Optional: rclone.exe path (default: PATH, else winget folder), rclone.conf
# path (default: rclone's own), log folder (default:
# %LOCALAPPDATA%\ShadowAssistant\logs).
SHADOW_BACKUP_RCLONE_PATH=
SHADOW_BACKUP_RCLONE_CONFIG=
SHADOW_BACKUP_LOG_DIR=
