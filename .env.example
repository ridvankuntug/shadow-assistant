# Copy this file to `.env` and fill in real values locally.
# `.env` is git-ignored. Never commit real tokens, hostnames or IP addresses.
# Variables already set in the real environment take precedence over `.env`.

# --- Core ---
# Interface the Core WebSocket API binds to. Default 127.0.0.1 (this machine
# only); use 0.0.0.0 to accept connections from the phone on the LAN.
CORE_HOST=127.0.0.1
# Port the Core WebSocket API listens on (ws://<host>:<port>/ws).
CORE_PORT=8700
# Model routing (see router.yaml and docs/04-router.md). Each value is a Claude
# model alias or id.
# Tier 1, cheap first try (short answers, one tool). Default: haiku.
CORE_MODEL_TIER1=
# Tier 2, default model. Default: CORE_MODEL, else sonnet.
CORE_MODEL_TIER2=
# Tier 3, only for explicit planning / deep-analysis requests. Default: opus.
CORE_MODEL_TIER3=
# Pre-T7 setting, still honoured: the tier-2 model when CORE_MODEL_TIER2 is empty
# (with CORE_ROUTER=off, the only model).
CORE_MODEL=
# off = no routing: every turn on the tier-2 model, no direct (model-free) Home
# Assistant calls, no escalation. Default: on.
CORE_ROUTER=
# Alternative router file. Default: router.yaml in the repo root.
SHADOW_ROUTER_FILE=
# Optional fallback. By default the Agent SDK uses the local Claude Code login;
# set an Anthropic API key only if that login should not be used.
ANTHROPIC_API_KEY=
# Safety switch for smoke tests: 1 = only `read` tools may run, everything else
# is denied without asking.
CORE_READ_ONLY=
# How long a confirmation waits before it counts as "no" (ms). Default: 60000.
CORE_CONFIRM_TIMEOUT_MS=

# --- Home Assistant (via MCP, see services.yaml) ---
# Base URL of your Home Assistant instance, e.g. http://homeassistant.local:8123
HA_URL=
# Long-lived access token created for the Core in Home Assistant.
HA_CORE_TOKEN=

# --- Speech services ---
# Base URL of whisper-svc (speech-to-text). Default: http://127.0.0.1:8701
WHISPER_SVC_URL=
# Base URL of tts-svc (Piper text-to-speech). Default: http://127.0.0.1:8702
TTS_SVC_URL=

# --- Shadow vault ---
# Absolute path of your notes vault. The read-only vault tool is disabled when
# this is empty. Readable folders are set in services.yaml (`allow`).
SHADOW_VAULT_DIR=
# Where conversation logs and usage records (usage/YYYY-MM-DD.jsonl) are
# written. Default: <SHADOW_VAULT_DIR>/.shadow-assistant (the Core puts a
# `.gitignore` containing `*` into it and into its usage/ folder).
SHADOW_DATA_DIR=

# --- Device tokens ---
# One token per client device (browser, Android shell); more can be added as
# DEVICE_TOKEN_<NAME>. Empty values are ignored; at least one is required and
# each must be at least 16 characters. Generate random values, e.g.
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
DEVICE_TOKEN_BROWSER=
DEVICE_TOKEN_ANDROID=
